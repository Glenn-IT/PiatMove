<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/badge_approval"
            android:backgroundTint="#EFF6FF"
            android:padding="6dp"
            android:src="@drawable/ic_about"
            app:tint="@color/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="About PiatMove"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Official Municipal Transport Office"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="2dp"
            android:text="PiatMove is designed to modernize and streamline local tricycle transport across all 18 barangays of Piat, Cagayan. The platform promotes passenger convenience, regulated fare compliance, and enhanced driver livelihoods."
            android:textColor="@color/grey_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Key Objectives"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:lineSpacingExtra="2dp"
            android:text="• Transparent, standardized municipal tricycle fare rates.\n• 100% verified and licensed local drivers.\n• Safe, dependable commuting for residents, students, and visitors."
            android:textColor="@color/grey_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App Version: 1.0 (Production Release 2026)"
            android:textColor="@color/grey_text"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseAbout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="Close"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>
